# VMS backend configuration — copy to .env and fill in.
# Every value here is machine-level environment config; application-level
# settings (branding, defaults, device list) live in the app_config table.
# Never read process.env outside src/config/.

# The database is swappable by connection string alone (local bundled Postgres
# by default, or a client-supplied/managed instance). Passed through untouched
# so provider-specific parameters and TLS settings survive.
DATABASE_URL=postgresql://vms_app:devpassword@localhost:47103/vms

# Connection pool size — managed providers often impose low connection limits.
DATABASE_POOL_SIZE=10

# HTTP port for the combined operator API + device ADMS endpoints.
# Installer-configurable — see backend/scripts/first-run-env.mjs --backend-port.
PORT=47102
ADMS_PORT=47102

# Photos always stay on local disk — only metadata lives in the database.
PHOTO_STORAGE_PATH=./data/photos

JWT_SECRET=change-me-to-a-long-random-string

# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Device user IDs are text (letters and digits), so classification is configured
# per device on the Devices page. Employee and Visitor patterns must be distinct
# and non-overlapping (for example Employee `1*`, Visitor `9*`). Empty patterns
# classify nobody automatically; an ambiguous ID is left untouched for Admin
# review. Configure patterns before enrolling/scanning on shared terminals; see
# docs/DPDP_SHARED_TERMINAL_RISK.md.

# Browser origins allowed to call the operator API (comma-separated).
# Empty reflects the requesting Origin. Installed consoles are accessed from
# the isolated LAN using the server's IP/hostname, which is not known when the
# installer is built. Bearer tokens are still required.
CORS_ORIGINS=

# Emit every SQL statement as a Prisma event. Off by default. Used by
# `npm run verify:e2e` to assert the getrequest query budget, and useful for
# diagnosing a slow remote database where one extra round trip per poll is
# the difference between working and unusable.
DATABASE_LOG_QUERIES=false

# Seconds of silence before a device is reported offline. The terminal polls
# roughly every 30 s when idle, so 90 s is three missed polls. Detection also
# includes up to 20 s of last_seen write throttling on top of this.
DEVICE_OFFLINE_AFTER_SECONDS=90

# How often the expiry sweeper runs (cron). This is the ONLY thing that
# removes a lapsed vendor from a device — the terminal stores validity dates
# and ignores them — so this interval is the worst case in which someone
# whose authorization has ended can still open a barrier.
EXPIRY_SWEEP_CRON=*/5 * * * *

# pg-boss runs its own connection pool, separate from Prisma's, and owns its
# own schema (which it creates and migrates itself). Keep the pool small: the
# jobs run minutes apart, never concurrently, and a managed database's
# connection limit is a real constraint.
JOBS_POOL_SIZE=2
JOBS_SCHEMA=pgboss

# Pretty-print logs instead of JSON. Unset = on when stdout is a terminal
# (i.e. a person is watching). Set false for a Windows service or anywhere
# logs are shipped to a collector, where JSON is the useful format.
# pino-pretty is a devDependency; if it is absent this silently falls back to
# JSON rather than failing to boot.
LOG_PRETTY=true

# The hour, in each DEVICE's local time, at which SINGLE_ENTRY vendors are
# un-blocked for a new day. 0 = midnight, matching the calendar-day meaning of
# "one entry per day". Raise it if a shift spans midnight, so the reset cannot
# release someone in the middle of their own shift.
DAILY_RESET_HOUR=0

# How often to CHECK whether a device has rolled into a new local day. Not the
# reset time — the reset happens once per device-local day whatever this is.
# A short interval only decides how promptly it lands after the hour, and lets
# a midnight missed to downtime be caught up quickly.
DAILY_RESET_CRON=*/15 * * * *

# How often the reconciliation sweep asks the device about a slice of the
# roster. This is a security control, not housekeeping: it is what catches a
# vendor still loaded on a terminal after their authorization ended, which is
# otherwise completely silent (the device has no native expiry).
RECONCILE_CRON=0 * * * *

# Vendors checked per sweep. Each check is a command the device collects on a
# poll, so a whole roster at once would starve real work behind it.
RECONCILE_BATCH=25

# How long raw punches are kept before being rolled into day summaries and
# deleted. The movement record SURVIVES the prune — only its granularity is
# lost — so this is rotation, not erasure. At 1,200–1,500 movements/day this
# table gains ~500k rows a year.
PUNCH_RETENTION_DAYS=400

# Completed device commands. Only SUCCESS rows are ever pruned: a FAILED
# command is evidence that something never reached a barrier.
COMMAND_RETENTION_DAYS=120

# Audit log. UNSET = never pruned, deliberately. It records who authorized
# whom to enter a site — the one thing an investigation needs. DPDP's "no
# longer than necessary" pulls the other way; resolving that tension is a
# client policy decision, not a default. Uncomment to opt in.
# AUDIT_RETENTION_DAYS=1095

# Nightly by default: nothing here is urgent, and it is the one job that
# deletes rows in bulk — best kept away from a shift change.
RETENTION_CRON=30 3 * * *
RETENTION_BATCH=2000
RETENTION_PASSES_PER_RUN=10

# Face-capacity alert thresholds, as a percentage of the device's own reported
# maximum. On this hardware (3,000 faces) these land at 2,100 and 2,550. The
# ceiling is hard: at capacity a provision fails, and it fails while somebody
# is waiting at a gate.
FACE_CAPACITY_WARN_PERCENT=70
FACE_CAPACITY_CRITICAL_PERCENT=85

# How long a command may sit queued, while its device is online and polling,
# before that counts as dispatch being broken rather than the device being
# away. Generous — the queue is deliberately unhurried.
COMMAND_STUCK_MINUTES=15

# Row cap on a CSV export. A year of movement is hundreds of thousands of
# rows; an export that quietly truncates is worse than one that says so, so
# the response carries X-Report-Truncated and the caller narrows the range.
REPORT_EXPORT_MAX_ROWS=50000

# Ed25519 public key (PEM) used to verify an installed license key. Generate
# a keypair with `node scripts/license/generate-keypair.mjs` (run offline,
# never on a client machine) and set this to the PUBLIC half only. Absent =
# no paid key can be installed. The release staging command injects this
# public verification key; it is not secret and the private half never ships.
# Paste the PEM as-is, quoted, real line breaks and all — dotenv supports
# multi-line quoted values:
# LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
# MCowBQYDK2VwAyEA...
# -----END PUBLIC KEY-----"
