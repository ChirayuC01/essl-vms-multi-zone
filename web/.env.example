# Base URL of the VMS backend (operator API + SSE stream), read at request
# time by the root layout server component and injected into the page as
# window.__VMS_API_BASE__ before hydration (see web/src/lib/api.ts). Set by
# the installer via web/scripts/first-run-env.mjs --backend-port so the
# backend's port can change without rebuilding this app. In a LAN browser,
# the frontend replaces this loopback hostname with the hostname/IP used to
# open the web console while preserving the configured backend port.
API_BASE_URL=http://localhost:47102

# Dev-only fallback: NEXT_PUBLIC_* is inlined at build time, so this only
# matters for `npm run dev` / a local `next build`, never the packaged
# installer build (which relies on API_BASE_URL above instead).
NEXT_PUBLIC_API_URL=http://localhost:47102
